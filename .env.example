# Langfuse (obtenha do seu projeto Langfuse Cloud ou self-hosted)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# --- LLM Genérico (OpenAI compatible) ---
# Ex para Ollama: http://localhost:11434/v1
# Ex para Hugging Face Space: <URL_DO_SEU_SPACE>/v1
LLM_API_BASE_URL=""

# Ex para Ollama: "ollama" (ou qualquer string)
# Ex para OpenAI: sua chave "sk-..."
LLM_API_KEY="not-needed"

# O nome do modelo que o endpoint está servindo
# Ex para Ollama: "llama3"
# Ex para OpenAI: "gpt-4o"
LLM_MODEL_NAME="llama3"